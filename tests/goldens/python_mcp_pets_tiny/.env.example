API_BASE_URL=https://petstore.example.com/v1
# Auth mode from wizard security config: none
# No authentication (development only)
# Largest response body the server reads (bytes):
# MAX_RESPONSE_BYTES=1048576
MCP_TRANSPORT=stdio
# Streamable HTTP instead of stdio (README: Run over HTTP):
# MCP_TRANSPORT=streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_PATH=/mcp
# Non-loopback MCP_HOST needs platform: a gateway such as AgentCore checks tokens.
# MCP_AUTH=none
# Comma-separated Host values to answer (DNS-rebinding protection):
# MCP_ALLOWED_HOSTS=
