{
  "target": "local",
  "language": "python",
  "sdk": "mcp (official Python SDK; MCPServer high-level API, mcp>=2,<3)",
  "title": "Pets Tiny API",
  "version": "1.0.0",
  "package": "pets_tiny_mcp",
  "tools": [
    {
      "name": "listpets",
      "operationId": "listPets",
      "method": "get",
      "path": "/pets"
    },
    {
      "name": "showpetbyid",
      "operationId": "showPetById",
      "method": "get",
      "path": "/pets/{petId}"
    }
  ],
  "security": {
    "authMode": "oauth2",
    "secretsStrategy": "dotenv_example_only",
    "oauth": {
      "tokenUrl": "https://auth.example.com/oauth2/token",
      "scopes": [
        "pets.read"
      ],
      "audience": "https://petstore.example.com"
    }
  }
}
